#!/usr/bin/env bash
# Zelfuitpakkende installer voor Ziggo DVB-C Monitor
set -Eeuo pipefail

red='\033[0;31m'; green='\033[0;32m'; cyan='\033[0;36m'; reset='\033[0m'
die() { printf "${red}FOUT:${reset} %s\n" "$*" >&2; exit 1; }

[[ $EUID -eq 0 ]] || die "Start met sudo: sudo bash $0"
command -v base64 >/dev/null 2>&1 || die "Het commando base64 ontbreekt (installeer coreutils)."
command -v tar >/dev/null 2>&1 || die "Het commando tar ontbreekt."

TMP_DIR="$(mktemp -d /tmp/dvb-c-monitor-install.XXXXXX)"
cleanup() { rm -rf "$TMP_DIR"; }
trap cleanup EXIT INT TERM

printf "${cyan}Ziggo DVB-C Monitor${reset}\n"
printf 'Ingebouwde projectbestanden uitpakken...\n'
sed '1,/^__ARCHIVE_BELOW__$/d' "$0" | base64 -d | tar -xz -C "$TMP_DIR"
[[ -f "$TMP_DIR/app/main.py" ]] || die "Het ingebouwde installatiepakket is beschadigd."
chmod +x "$TMP_DIR/tools/install-linux.sh"

# De eigenlijke installer installeert pakketten, kopieert naar /opt,
# configureert systemd en start de webservice.
SOURCE_DIR="$TMP_DIR" TARGET_DIR="/opt/dvb-c-monitor" \
  bash "$TMP_DIR/tools/install-linux.sh"
exit 0
