DVB_ADAPTER=0
DVB_FRONTEND=0
DVB_TUNING_FILE=/usr/share/dvb/dvb-c/nl-Ziggo
DVB_CHANNELS_FILE=data/channels.conf
SCAN_INTERVAL_MINUTES=360
SCAN_ON_START=false
ENABLE_SCHEDULER=true
REMOVAL_GRACE_SCANS=2
# Voor een eigen hardwareprobe; placeholders: {adapter}, {frontend}, {tuning_file}, {channels_file}
# Het commando mag JSON naar stdout schrijven of een dvbv5 channels.conf maken.
# DVB_SCAN_COMMAND=python3 tools/demo_scan.py
